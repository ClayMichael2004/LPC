# ==============================================================================
# Little Polo Cafe (LPC) Backend Environment Configuration Template
# Copy this file to .env and fill in your credentials. NEVER commit .env to git.
# ==============================================================================

PORT=8085
ENV=development

# Database (PostgreSQL 16+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=lpc_db
DATABASE_URL=postgres://postgres:change_me_db_password@localhost:5435/lpc_db?sslmode=disable

# Cache & PubSub (Redis 7+)
REDIS_URL=localhost:6380
REDIS_PASSWORD=

# Security & Authentication (JWT HS256)
JWT_SECRET=change_me_to_a_long_random_256_bit_secret_key
JWT_EXPIRY_HOURS=168

# Email OTP & Welcome Email Configuration (Gmail SMTP App Password)
OTP_SENDER_EMAIL=your-sender-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# Administrator (Cafe Owner) Credentials
ADMIN_EMAIL=admin@littlepolocafe.local
ADMIN_PASSWORD=change_me_admin_password

# CORS (Allow mobile app origins)
CORS_ALLOWED_ORIGINS=*
